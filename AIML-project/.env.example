# ==========================================
# AI Urban Cadastral Mapping Configuration
# ==========================================

# Backend API Configuration
PORT=8001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database Configuration
# Recommended for a laptop demo: leave DATABASE_URL blank. The backend uses persistent SQLite at data/cadastral.db.
# PostgreSQL/PostGIS is optional for deployment or multi-user setups.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cadastral
POSTGRES_USER=cadastral
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://cadastral:your_secure_password_here@localhost:5432/cadastral

# Storage Directories
MODEL_DIR=models
UPLOAD_DIR=data/sample
EXPORTS_DIR=data/exports
SQLITE_PATH=data/cadastral.db

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://127.0.0.1:8001/api
